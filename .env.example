# Copy to .env (docker compose reads it automatically). All optional.
PORT=8080                       # host port judges connect to
PUBLIC_URL=                     # e.g. http://10.1.2.3:8080 — printed in logs as the judge link
JUDGES=7                        # roster size used when codes are first generated
SESSION_HOURS=24
# Plain `npm start` also reads these from the environment:
HOST=0.0.0.0
DATA_DIR=./data
